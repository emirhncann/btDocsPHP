{
    "name": "btdocs/backend",
    "description": "Logo ERP entegrasyonlu döküman yönetim sistemi API",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^7.1",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public"
    }
}
