APP_ENV=development

# Logo ERP veritabanı (read-only)
LOGO_DB_HOST=localhost
LOGO_DB_NAME=LOGO_DB
LOGO_DB_USER=
LOGO_DB_PASS=

# Uygulama veritabanı
APP_DB_HOST=localhost
APP_DB_NAME=BTDOCS_DB
APP_DB_USER=
APP_DB_PASS=

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL_HOURS=8

# Belge dosya kökü (mutlak yol önerilir)
DOC_STORAGE_ROOT=C:\DocStorage

# Logo tablo desenleri ({FIRMA}=001, {DONEM}=01)
# LOGO_TABLE_CLCARD=LG_{FIRMA}_CLCARD
# LOGO_TABLE_ITEMS=LG_{FIRMA}_ITEMS
# LOGO_TABLE_SIPARIS_HEADER=LG_{FIRMA}_{DONEM}_ORFICHE
# LOGO_TABLE_SIPARIS_LINE=LG_{FIRMA}_{DONEM}_ORFLINE
# LOGO_TABLE_IRSALIYE_HEADER=LG_{FIRMA}_{DONEM}_STFICHE
# LOGO_TABLE_IRSALIYE_LINE=LG_{FIRMA}_{DONEM}_STLINE
# LOGO_TABLE_FATURA_HEADER=LG_{FIRMA}_{DONEM}_STFICHE
# LOGO_TABLE_FATURA_LINE=LG_{FIRMA}_{DONEM}_STLINE

# STFICHE TRCODE filtreleri (kuruluma göre ayarlayın; boş = filtre yok)
LOGO_TRCODES_SIPARIS=
LOGO_TRCODES_IRSALIYE=6,7
LOGO_TRCODES_FATURA=8,9

# Public /belge erişiminde AccessTokens zorunluluğu (şimdilik kapalı)
PUBLIC_ACCESS_TOKEN_REQUIRED=false

# CORS — development'ta * tüm origin'lere izin verir (Origin yansıtılır).
# Production'da açıkça yazın, wildcard kullanmayın:
# CORS_ALLOWED_ORIGINS=https://admin.sirket.local
CORS_ALLOWED_ORIGINS=*
