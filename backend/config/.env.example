APP_ENV=development

# Logo ERP veritabanı (read-only arama; PERDOC not yazımı istisna)
LOGO_DB_HOST=localhost
LOGO_DB_NAME=LOGO_DB
LOGO_DB_USER=
LOGO_DB_PASS=

# Uygulama veritabanı
APP_DB_HOST=localhost
APP_DB_NAME=BTDOCS_DB
APP_DB_USER=
APP_DB_PASS=

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL_HOURS=8

# Belge dosya kökü (mutlak yol önerilir)
DOC_STORAGE_ROOT=C:\DocStorage

# Diğer PC'lerden erişim kök adresi (Logo PERDOC notuna /belge/{uid})
# Örn. http://192.168.1.10:8080  (sonunda / olmadan)
PUBLIC_BASE_URL=

# Logo PERDOC / INVOICE (varsayılanlar canlı UI ile uyumlu; genelde override gerekmez)
# LOGO_TABLE_PERDOC=LG_{FIRMA}_{DONEM}_PERDOC
# LOGO_TABLE_INVOICE=LG_{FIRMA}_{DONEM}_INVOICE

# Logo tablo desenleri ({FIRMA}=001, {DONEM}=01)
# LOGO_TABLE_CLCARD=LG_{FIRMA}_CLCARD
# LOGO_TABLE_ITEMS=LG_{FIRMA}_ITEMS
# LOGO_TABLE_SIPARIS_HEADER=LG_{FIRMA}_{DONEM}_ORFICHE
# LOGO_TABLE_SIPARIS_LINE=LG_{FIRMA}_{DONEM}_ORFLINE
# LOGO_TABLE_IRSALIYE_HEADER=LG_{FIRMA}_{DONEM}_STFICHE
# LOGO_TABLE_IRSALIYE_LINE=LG_{FIRMA}_{DONEM}_STLINE
# LOGO_TABLE_FATURA_HEADER=LG_{FIRMA}_{DONEM}_STFICHE
# LOGO_TABLE_FATURA_LINE=LG_{FIRMA}_{DONEM}_STLINE

# TRCODE filtreleri (kuruluma göre ayarlayın; boş = filtre yok)
# Sipariş/irsaliye: STFICHE / ORFICHE.
# Fatura: INVOICE (1 perakende, 2 toptan, 3 verilen hizmet, 4 alınan hizmet, 7 bu kurulumdaki ana fatura)
LOGO_TRCODES_SIPARIS=
LOGO_TRCODES_IRSALIYE=6,7
LOGO_TRCODES_FATURA=1,2,3,4,7

# Public /belge erişiminde AccessTokens zorunluluğu (şimdilik kapalı)
PUBLIC_ACCESS_TOKEN_REQUIRED=false

# Lisans paneli (Proje C)
# Tam doğrulama URL'si: {LICENSE_PANEL_URL}/api/license-verify.php?api_key={LICENSE_API_KEY}
LICENSE_PANEL_URL=https://btdocs.boluteknoloji.tr
LICENSE_API_KEY=
# CORS — development'ta * tüm origin'lere izin verir (Origin yansıtılır).
# Production'da açıkça yazın, wildcard kullanmayın:
# CORS_ALLOWED_ORIGINS=https://admin.sirket.local
CORS_ALLOWED_ORIGINS=*
