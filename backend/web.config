<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- Statik dosyalar ve public/ altı doğrudan sunulsun -->
                <rule name="Static and public files" stopProcessing="true">
                    <match url="^public/(.*)$" ignoreCase="true" />
                    <action type="None" />
                </rule>
                <!-- Diğer tüm istekleri public/index.php'ye yönlendir -->
                <rule name="Rewrite to front controller" stopProcessing="true">
                    <match url="^(.*)$" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="public/index.php" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
        <defaultDocument>
            <files>
                <clear />
                <add value="public/index.php" />
            </files>
        </defaultDocument>
        <httpErrors existingResponse="PassThrough" />
        <security>
            <requestFiltering removeServerHeader="true">
                <!-- ~22 MB — uygulama 20MB dosya limiti ile uyumlu -->
                <requestLimits maxAllowedContentLength="23068672" />
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
